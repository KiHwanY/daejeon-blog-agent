# Anthropic API 키 (https://console.anthropic.com/ 에서 발급)
# 이 파일을 .env 로 복사한 뒤 실제 값으로 채우세요. .env 는 절대 커밋하지 마세요.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL + pgvector 접속 정보 (README 4단계 docker 컨테이너와 값이 일치해야 함)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=daejeon_blog
DB_USER=bloguser
DB_PASSWORD=blogpass

# (선택) Pexels 이미지 API 키 (https://www.pexels.com/api/ 에서 무료 발급)
# 없으면 블로그 카드가 기존 플레이스홀더 이미지를 사용합니다.
PEXELS_API_KEY=
